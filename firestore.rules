rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Funcao auxiliar: usuario autenticado e dono do registro (uid)
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Colecao de usuarios e suas subcolecoes privadas
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Veiculos do usuario (carros e motos)
      match /vehicles/{vehicleId} {
        allow read, write: if isOwner(uid);
      }

      // Historico de manutencoes
      match /maintenances/{maintenanceId} {
        allow read, write: if isOwner(uid);
      }

      // Historico de abastecimentos
      match /fuel/{fuelId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
